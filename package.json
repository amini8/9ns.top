{
  "name": "9ns-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "npm run build && node tools/check.mjs",
    "smoke": "npm run check && node tools/smoke.mjs",
    "dev": "npm run build && wrangler dev",
    "dry-run": "npm run check && wrangler deploy --dry-run",
    "deploy": "npm run check && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.159.0"
  }
}
